{
  "mcpServers": {
    "windbg": {
      "command": "python",
      "args": [
        "-m",
        "mcp_windbg",
        "--cdb-path",
        "C:\\Program Files (x86)\\Windows Kits\\10\\Debuggers\\x64\\cdb.exe",
        "--symbols-path",
        "srv*C:\\Symbols*https://msdl.microsoft.com/download/symbols",
        "--timeout",
        "120"
      ]
    }
  }
}
